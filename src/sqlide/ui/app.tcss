#side {
    width: 28%;
    min-width: 24;
    max-width: 44;
    border-right: solid $primary-darken-2;
}
#sidebar { height: 35%; }
#schema { height: 1fr; border-top: solid $primary-darken-2; }
#sidebar ListItem { padding: 0 1; }
#sidebar .dim { color: $text-muted; text-style: italic; }
#editor { height: 3fr; }
#results { height: 2fr; border-top: solid $primary-darken-2; }

ConfirmScreen, PasswordPrompt, ProgressScreen, ConnectionEditor, SettingsScreen,
DriverManager, DriverEditor { align: center middle; }
.dialog {
    width: 60;
    height: auto;
    padding: 1 2;
    border: thick $primary;
    background: $surface;
}
.dialog.wide { width: 80; }
.dialog { max-height: 100%; overflow-y: auto; }
.dialog .title { text-style: bold; margin-bottom: 1; }
.dialog .buttons { height: auto; margin-top: 1; }
.dialog .buttons Button { margin-right: 2; }
.dialog .row { height: 3; }
.dialog .row Label { margin-right: 2; padding-top: 1; }
.dialog .error { color: $error; }

.dialog.viewer { width: 90%; height: 80%; }
.dialog.viewer TextArea { height: 1fr; }
.dialog .hint { color: $text-muted; margin-top: 1; }
ValueViewer, CopyMenu { align: center middle; }
CopyMenu OptionList { height: auto; max-height: 12; }

ExportScreen { align: center middle; }
ExportScreen RadioSet { height: auto; }
ExportScreen .row Input { width: 12; }
ExportScreen #table_name { width: 40; }

#tabs { width: 1fr; }
ConsoleTabs > ContentSwitcher { height: 1fr; }
ConsoleTabs TabPane { padding: 0; height: 1fr; }
ConsoleTab { height: 1fr; }
PathPrompt { align: center middle; }

HistoryScreen { align: center middle; }
#history {
    width: 90%;
    height: 85%;
    padding: 1 2;
    border: round $primary;
    background: $surface;
}
#history-title { text-style: bold; }
#history-list { height: 1fr; }
#history-preview {
    height: 8;
    padding: 0 1;
    border-top: solid $primary-darken-2;
    overflow-y: auto;
}

#driver-list { height: 12; }
.dialog .hint { color: $text-muted; margin-top: 1; }

ScopeScreen { align: center middle; }
#scope-box {
    width: 80%;
    height: 85%;
    padding: 1 2;
    border: round $primary;
    background: $surface;
}
#scope-title { text-style: bold; }
#scope-list { height: 1fr; }
#scope-box .buttons { height: auto; margin-top: 1; }
#scope-box .buttons Button { margin-right: 1; }
